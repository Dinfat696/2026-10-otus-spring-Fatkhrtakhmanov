<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Resource - имя CSV-файла захардкожено строкой -->
    <bean id="questionResource" class="org.springframework.core.io.ClassPathResource">
        <constructor-arg value="questions.csv"/>
    </bean>

    <!-- DAO: читает вопросы из CSV-ресурса -->
    <bean id="questionDao" class="ru.otus.quiz.dao.QuestionDaoCsv">
        <constructor-arg ref="questionResource"/>
    </bean>

    <!-- Сервис: в конструктор передаётся DAO -->
    <bean id="questionService" class="ru.otus.quiz.service.QuestionServiceImpl">
        <constructor-arg ref="questionDao"/>
    </bean>

    <!-- Вывод вопросов в консоль: зависимостей нет -->
    <bean id="consoleService" class="ru.otus.quiz.service.ConsoleService"/>

</beans>
